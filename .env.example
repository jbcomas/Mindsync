# Dev only. Nunca reutilizar estas credenciales fuera de local.
DATABASE_URL_MIGRATOR=postgres://ms_migrator:migrator_dev@localhost:54329/mindsync
DATABASE_URL_APP=postgres://ms_app:app_dev@localhost:54329/mindsync
DATABASE_URL_WORKER=postgres://ms_worker:worker_dev@localhost:54329/mindsync
# Solo para fixtures de tests (crea datos saltando RLS). Nunca usar en la app.
DATABASE_URL_ADMIN=postgres://postgres:postgres_dev@localhost:54329/mindsync

# --- Passkeys (WebAuthn) ---
# Los passkeys quedan atados al dominio (RP ID): si cambiás de dominio, los passkeys existentes dejan de funcionar.
# Local: no hace falta definirlos (ORIGIN=http://localhost:3000, RP_ID=localhost).
# Detrás de un túnel HTTPS (para usar el micrófono/passkeys en el celular), poné el dominio público:
# ORIGIN=https://mindsync.tu-dominio.com
# RP_ID=mindsync.tu-dominio.com
# Producción: SESSION_SECRET de >= 32 caracteres aleatorios (obligatorio).
# SESSION_SECRET=
# Solo desarrollo local, si no tenés cómo usar passkeys: habilita /api/dev-login (entrar con un email, sin passkey).
# Se niega a arrancar en producción. Usa DATABASE_URL_ADMIN.
# DEV_LOGIN=1

# --- Correo (verificación de email) ---
# Sin SMTP_URL, en desarrollo NO se envía nada: el enlace aparece en el log del servidor y en la app ("Ver correo de desarrollo").
# En producción SMTP_URL y MAIL_FROM son obligatorios. Ejemplo (Resend/Postmark/SES/Gmail con contraseña de aplicación):
# SMTP_URL=smtps://usuario:clave@smtp.tu-proveedor.com:465
# MAIL_FROM="MindSync <no-reply@tu-dominio.com>"
# Para que los correos lleguen (y no a spam) el dominio del remitente necesita SPF, DKIM y DMARC configurados.
